{
  "name": "@justsenger/win-on-web",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build:wow": "node scripts/build-wow.mjs && pnpm build:wow:voxel && pnpm build:wow:games",
    "build:wow:voxel": "node scripts/prepare-voxel-sources.mjs && node scripts/build-classicube-wow.mjs && node scripts/build-luanti-wow.mjs",
    "build:wow:games": "node scripts/build-h5mota-wow.mjs && node scripts/build-tinystrike-wow.mjs && node scripts/build-ouro.mjs && node scripts/build-upstream-arcade.mjs && node scripts/write-game-catalog.mjs",
    "build": "node scripts/write-game-catalog.mjs && astro build",
    "build:pages": "pnpm build && node scripts/stage-pages.mjs",
    "preview": "node scripts/start.mjs preview",
    "check": "tsc --noEmit && node scripts/verify-boundaries.mjs"
  },
  "exports": {
    "./contracts": "./src/wow/contracts/index.ts",
    "./hal": "./src/wow/hal/index.ts",
    "./kernel": "./src/wow/kernel/index.ts",
    "./runtime": "./src/wow/runtime/index.ts",
    "./protocol": "./src/wow/runtime/protocol.ts",
    "./desktop": "./src/shells/win11/Win11Desktop.astro",
    "./tokens.css": "./src/shells/win11/win11-tokens.css",
    "./host-config": "./src/shells/win11/host-config.ts"
  },
  "dependencies": {
    "astro": "7.4.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
